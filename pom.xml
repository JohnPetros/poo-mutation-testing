<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ctrlaltdel</groupId>
    <artifactId>frete-mutacao</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>Teste de Mutacao OO - Calculo de Frete</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            O codigo de producao evita recursos posteriores ao Java 6 para continuar
            compativel com o muJava. O JDK 21 nao gera bytecode abaixo do Java 8,
            entao o alvo de compilacao aqui e o 8.
        -->
        <maven.compiler.release>8</maven.compiler.release>

        <!--
            Suite de testes em uso: "inicial" (cobertura alta, assercoes fracas)
            ou "reforcada" (guiada pelos mutantes sobreviventes).
            Troque com: mvn ... -Dsuite=reforcada
        -->
        <suite>inicial</suite>

        <junit.version>4.13.2</junit.version>
        <jacoco.version>0.8.12</jacoco.version>
        <pitest.version>1.16.1</pitest.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testSourceDirectory>src/test/${suite}/java</testSourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- Cobertura de linha e de desvio -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-${suite}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Mutacao de nivel de metodo -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <configuration>
                    <targetClasses>
                        <param>frete.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>frete.*</param>
                    </targetTests>
                    <mutators>
                        <mutator>DEFAULTS</mutator>
                    </mutators>
                    <outputFormats>
                        <format>HTML</format>
                        <format>XML</format>
                    </outputFormats>
                    <reportsDirectory>${project.build.directory}/pit-reports/${suite}</reportsDirectory>
                    <timestampedReports>false</timestampedReports>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
